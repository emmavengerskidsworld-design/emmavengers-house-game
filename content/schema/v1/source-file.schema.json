{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://emmavengerskidsworld-design.github.io/emmavengers-house-game/content/schema/v1/source-file.schema.json",
 "title": "Authoring source file: a list of records belonging to the pack of its folder",
 "type": "object", "additionalProperties": false, "required": ["records"],
 "properties": {"$schema": {"type": "string"}, "note": {"type": "string"},
  "records": {"type": "array", "minItems": 1, "maxItems": 5000, "items": {"type": "object", "required": ["id", "type"]}}}
}
