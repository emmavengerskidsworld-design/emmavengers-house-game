           "type": "string"
          },
          "pos": {
           "enum": [
            "n",
            "ne",
            "e",
            "se",
            "s",
            "sw",
            "w",
            "nw"
           ]
          },
          "name": {
           "$ref": "#/$defs/lt"
          }
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "template": {
        "const": "evidence-comparison.v1"
