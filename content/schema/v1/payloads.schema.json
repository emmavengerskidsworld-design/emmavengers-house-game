     "then": {
      "additionalProperties": false,
      "required": [
       "table",
       "questions"
      ],
      "properties": {
       "key": true,
       "template": true,
       "icon": true,
       "title": true,
       "lines": true,
       "caption": {
        "$ref": "#/$defs/lt"
       },
       "feedback": {
        "$ref": "#/$defs/lt"
       },
       "table": {
        "type": "array",
        "items": {
         "type": "object",
         "additionalProperties": false,
         "properties": {
          "source": {
           "$ref": "#/$defs/lt"
          },
          "value": {
           "$ref": "#/$defs/lt"
          }
         }
        }
       },
       "questions": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/choiceQuestion"
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "template": {
        "const": "inquiry.v1"
       }
      }
     },
     "then": {
      "additionalProperties": false,
      "required": [
       "table",
       "task",
       "claimFromQuiz",
       "next"
